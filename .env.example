# Workspace
KB_WORKSPACE_ROOT=.
KB_WEB_HOST=127.0.0.1
KB_WEB_PORT=8088
KB_REQUIRE_AUTH=false
KB_AUTH_TOKEN=
KB_ENABLE_LOCAL_FALLBACK=true
KB_ALLOWED_PROVIDERS=auto,ragflow,local

# RAGFlow local defaults
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=
RAGFLOW_TECHNICAL_ACTIVE_DATASET_ID=
RAGFLOW_CHAT_ID=
RAGFLOW_SEARCH_ID=
RAGFLOW_CHAT_MODEL=model
RAGFLOW_TECHNICAL_ACTIVE_DATASET_NAME=technical_active
RAGFLOW_CHAT_NAME=technical_procedure_chat
RAGFLOW_BOOTSTRAP_LLM_ID=

# Optional OpenAI-compatible LLM after retrieval.
# Leave empty for offline extractive answers.
POC_LLM_BASE_URL=https://api.openai.com/v1
POC_LLM_API_KEY=
POC_LLM_MODEL=

# MinerU conversion.
MINERU_EXECUTABLE=mineru
MINERU_BACKEND=
MINERU_API_URL=http://127.0.0.1:8010
MINERU_BACKEND_URL=
MINERU_TIMEOUT_SECONDS=1800
