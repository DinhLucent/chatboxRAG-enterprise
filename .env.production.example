# Copy to .env or set variables in your deployment secret store.

KB_WEB_PORT=8088
KB_REQUIRE_AUTH=true
KB_AUTH_TOKEN=change-me-long-random-token
KB_ENABLE_LOCAL_FALLBACK=false
KB_ALLOWED_PROVIDERS=auto,ragflow
INSTALL_MINERU=false

# When the app runs in Docker and RAGFlow runs on the host machine.
RAGFLOW_BASE_URL=http://host.docker.internal:9380
RAGFLOW_API_KEY=
RAGFLOW_TECHNICAL_ACTIVE_DATASET_ID=
RAGFLOW_CHAT_ID=
RAGFLOW_SEARCH_ID=
RAGFLOW_CHAT_MODEL=model
RAGFLOW_TECHNICAL_ACTIVE_DATASET_NAME=technical_active
RAGFLOW_CHAT_NAME=technical_procedure_chat
RAGFLOW_BOOTSTRAP_LLM_ID=

# Optional OpenAI-compatible model for answer generation after retrieval.
POC_LLM_BASE_URL=https://api.openai.com/v1
POC_LLM_API_KEY=
POC_LLM_MODEL=

MINERU_EXECUTABLE=mineru
MINERU_BACKEND=
MINERU_API_URL=http://127.0.0.1:8010
MINERU_BACKEND_URL=
MINERU_TIMEOUT_SECONDS=1800
